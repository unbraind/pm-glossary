  - command: "npm run identity:check && npm run build && node --test --test-concurrency=2 --test-name-pattern=\"daily release remains\" test/workflow.test.ts"
    scope: project
    timeout_seconds: 300
    provenance:
      author: codex-sol
      created_at: "2026-11-06T21:21:16.376Z"
      source_kind: local_mutation
      source_ref: chore/close-delivered-items-1106
close_reason: "PR #5; commit 9432b69937fb6adbfa9eacc9b5456f6425479c5b; test evidence: identity:check passes across 6 commits and 95 tracked files; workflow.test.ts passes 3/3 on main. Dependabot #3 head 00f63aa844bffb5af78395a60fa0f04256dd7ad1 passed Node 22/26 CI run 42176620885 and merged as 3273c6cdcffc66b9c89e298363126234213ee1bb. Input/comment equality was superseded by the documented reviewed removal of pm-github-version. Tags are three separate values."
body: ""
